# Create .env from this file. Do not commit the real token.
TELEGRAM_BOT_TOKEN=replace_with_a_NEW_token_from_BotFather
# A long, random string Telegram sends in the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_value
# Public HTTPS address serving this app, without a trailing slash.
PUBLIC_BASE_URL=https://example.com
# Optional: only these Telegram numeric user IDs may use the bot. Leave blank to allow all.
ALLOWED_TELEGRAM_USER_IDS=
# Optional CSV exported from a licensed/authorized provider. See README for columns.
CANDIDATES_CSV=candidates.csv
# Optional public-web search provider. When set, this takes precedence over CSV lookup.
BRAVE_SEARCH_API_KEY=
# Preferred for structured people searches. A Prospeo free account has limited API access.
PROSPEO_API_KEY=
